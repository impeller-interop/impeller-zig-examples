[help] Build Metal+Vulkan Planet Shader
[desc] Compile the planet fragment shader for Metal and Vulkan.
[desc] See: https://github.com/impeller-interop/impeller-sdk/releases/tag/impellerc
[pass] Shader compiled.
[fail] Shader compilation failed.
planet(name = "planet"):
    mkdir -p .zig-cache/tmp
    impellerc --runtime-stage-metal --runtime-stage-vulkan --input=src/shaders/shader/{{name}}.frag --input-type=frag --sl=src/shaders/shader/{{name}}.iplr --spirv=.zig-cache/tmp/{{name}}.spv --iplr --verbose

[help] Build Liquid Glass Shader
[desc] Compile the procedural liquid glass shader for Metal and Vulkan.
[pass] Shader compiled.
[fail] Shader compilation failed.
liquid-glass():
    mkdir -p .zig-cache/tmp
    impellerc --runtime-stage-metal --runtime-stage-vulkan --input=src/shaders/shader/liquid_glass.frag --input-type=frag --sl=src/shaders/shader/liquid_glass.iplr --spirv=.zig-cache/tmp/liquid_glass.spv --iplr --verbose

[help] Format
[pass] Formatting complete.
[fail] Formatting failed.
fmt():
    zig fmt src build.zig build.zig.zon

[help] Clean Cache, Output
[pass] Clean complete.
